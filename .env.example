# Salvo — environment template. Copy to .env (gitignored) and fill in real values.
# The app runs fully OFFLINE by default (mock providers, zero credentials) — none of
# these are required for the demo. Set the B2 keys to run against real Backblaze B2.
#
# Each variable notes WHERE to get its value.

# 1 = OFFLINE demo mode (mock providers + LocalDirBackend, no network). Default.
# Also implied automatically when no B2 credentials are present.
OFFLINE=1

# --- Backblaze B2 (scoped application key — never the account master key) ---
# Where: https://secure.backblaze.com → B2 Cloud Storage → Application Keys →
#   "Add a New Application Key". Scope it to the bucket below.
#   keyID → B2_KEY_ID, applicationKey → B2_APP_KEY (shown ONCE at creation — copy it).
B2_KEY_ID=
B2_APP_KEY=
# Bucket name — create under B2 → Buckets → "Create a Bucket" (must be globally unique).
B2_BUCKET_NAME=salvo-media
# B2 region slug — match your account's cluster. The cluster number shows in the B2
# console; region = us-<west|east>-00<cluster> (e.g. cluster 004 → us-west-004,
# cluster 005 → us-east-005). Endpoint is derived as s3.<region>.backblazeb2.com.
# Required for us-east-005 (it can't be auto-detected). Defaults to us-west-004 if unset.
B2_REGION=us-west-004

# --- Budget guardrail ---
# Self-chosen per-campaign hard cap: a campaign whose projected spend exceeds this
# is refused before spending (typed BUDGET_SKIP).
MAX_CAMPAIGN_COST_USD=1.00

# Optional: override the local object-store path (OFFLINE mode). Any writable path.
# SALVO_LOCAL_STORE=./var/local-store
